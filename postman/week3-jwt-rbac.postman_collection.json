{
  "info": {
    "name": "Serverless Quiz Week 3 – JWT + RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set two base URLs from Week2, create users/admin, run workflows. Expired token: set TTL 30s, login, wait >=31s; authorizer cache 0."
  },
  "variable": [
    {
      "key": "exam_api_base",
      "value": "https://YOUR-EXAM-API.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "attempt_api_base",
      "value": "https://YOUR-ATTEMPT-API.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "student_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "other_student_token",
      "value": ""
    },
    {
      "key": "expired_student_token",
      "value": ""
    },
    {
      "key": "exam_id",
      "value": "EXAM001"
    },
    {
      "key": "submission_id",
      "value": "NEW_SUBMISSION_ID"
    },
    {
      "key": "bad_token",
      "value": "invalid.jwt.value"
    }
  ],
  "item": [
    {
      "name": "01 Registration + login",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{exam_api_base}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"password\": \"ChangeThisStudentPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [201, 409]\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student (store token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{exam_api_base}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"password\": \"ChangeThisStudentPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"student_token\", pm.response.json().accessToken);",
                  "pm.test(\"Expected status [200]\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin (store token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{exam_api_base}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"REPLACE_WITH_ADMIN_PASSWORD\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"admin_token\", pm.response.json().accessToken);",
                  "pm.test(\"Expected status [200]\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject role=Admin in registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{exam_api_base}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"attack01\",\n  \"password\": \"ChangeThisPassword123!\",\n  \"role\": \"Admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [400]\", () => pm.expect([400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject incorrect login password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{exam_api_base}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"password\": \"wrong_password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [401]\", () => pm.expect([401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Role verification",
      "item": [
        {
          "name": "Admin creates exam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{exam_api_base}}/exams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Security Test Week 3\",\n  \"duration\": 20\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"exam_id\", pm.response.json().examId);",
                  "pm.test(\"Expected status [201]\", () => pm.expect([201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student forbidden create exam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{exam_api_base}}/exams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Attack\",\n  \"duration\": 20\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [403]\", () => pm.expect([403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin adds question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{exam_api_base}}/exams/{{exam_id}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"2 + 2 = ?\",\n  \"options\": {\n    \"A\": \"1\",\n    \"B\": \"2\",\n    \"C\": \"4\",\n    \"D\": \"5\"\n  },\n  \"correctAnswer\": \"C\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [201]\", () => pm.expect([201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student views exams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{exam_api_base}}/exams"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [200]\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student starts exam (store submission ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{attempt_api_base}}/exams/{{exam_id}}/start",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const d=pm.response.json(); pm.collectionVariables.set(\"submission_id\", d.submissionId); if (d.questions && d.questions.length) pm.collectionVariables.set(\"question_id\", d.questions[0].questionId); }",
                  "pm.test(\"Expected status [201]\", () => pm.expect([201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin forbidden start exam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{attempt_api_base}}/exams/{{exam_id}}/start",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [403]\", () => pm.expect([403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student submits answers (from first question)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{attempt_api_base}}/submissions/{{submission_id}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"{{question_id}}\": \"C\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Submission accepted\", () => pm.expect(pm.response.code).to.equal(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student checks result",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{attempt_api_base}}/submissions/{{submission_id}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [200]\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Negative JWT tests",
      "item": [
        {
          "name": "Missing token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{exam_api_base}}/exams"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [401]\", () => pm.expect([401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JWT denied",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bad_token}}"
              }
            ],
            "url": "{{exam_api_base}}/exams"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [401, 403]\", () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Expired JWT denied (login then wait > TTL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{expired_student_token}}"
              }
            ],
            "url": "{{exam_api_base}}/exams"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [401, 403]\", () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Another Student denied result",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{other_student_token}}"
              }
            ],
            "url": "{{attempt_api_base}}/submissions/{{submission_id}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status [403]\", () => pm.expect([403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}